# NGodingin Kanban — Environment template
# Salin ke .env untuk development lokal lalu isi nilai asli. JANGAN commit .env.
#
# Pemetaan Vercel (D.7) — masukkan setiap key di bawah SECARA TERPISAH untuk
# target environment terkait. Jangan pernah menyalin secret antarenvironment.
#
# Target              BETTER_AUTH_URL
# Local development   http://localhost:5173 (ganti port bila berbeda)
# Vercel Preview      https://kanban-ngodingin.vercel.app
# Vercel Production   https://kanban.ngodingin.xyz
#
# Vercel mengisi VERCEL_ENV otomatis; jangan set manual. Preview diperlakukan
# aplikasi sebagai staging. Global DB, BETTER_AUTH_SECRET, dan AUTH_RESEND_KEY
# wajib berbeda untuk development, preview/staging, dan production.

# --- Turso — POC 0.2.1 (latensi & cold start) ---
# URL koneksi DB: turso db show <nama-db> --url (atau di console.turso.io)
TURSO_DB_URL=https://<org>-<db>-<instance>.turso.io
# Token DB: turso db tokens create <nama-db>
TURSO_DB_TOKEN=<token-db>

# --- Turso API token (org-level) — dibutuhkan POC 0.2.2 (provisioning via @tursodatabase/api) ---
# Buat di console.turso.io → Settings → API Tokens (scope: org, create database)
TURSO_API_TOKEN=<token-api-org>
TURSO_ORG=<org-name>
TURSO_GROUP=<group-name>

# --- Fungsi Vercel hasil deploy poc/measure — POC 0.2.1 ---
# URL production setelah `vercel deploy --prod` (project poc/measure)
POC_URL=https://<deployment-url>.vercel.app

# --- Global DB (control plane) — dibutuhkan 0.3.x+ ---
# URL koneksi Global DB (libsql:// atau https:// ... turso.io) — token JWT database
GLOBAL_DB_URL=https://<org>-<db>-<instance>.turso.io
GLOBAL_DB_TOKEN=<token-db-jwt>

# --- Better Auth (0.8.x) ---
# Secret minimal 32 karakter; WAJIB beda antar environment (dev/staging/prod).
BETTER_AUTH_SECRET=<minimal-32-karakter-acak>
# Template ini untuk development lokal. Di Vercel gunakan nilai pada pemetaan di atas.
BETTER_AUTH_URL=http://localhost:5173

# --- Resend (Magic Link transport, 0.8.4) ---
# Secret terpisah per environment (D.7); gunakan key Resend non-production untuk Preview.
AUTH_RESEND_KEY=re_<secret-resend>
# Sender tetap; jangan diubah kecuali via revisi SOT
MAIL_FROM=noreply@kanban.ngodingin.xyz
