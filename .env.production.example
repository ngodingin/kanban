# NGodingin Kanban — Environment: production
# Nilai diisi sebagai Environment Variables Vercel untuk project production
# (tidak dicommit; template ini hanya dokumentasi kunci D.7).

# --- Global DB (control plane) — DB production terisolasi penuh (D.7) ---
GLOBAL_DB_URL=https://<org>-<db-prod>-<instance>.turso.io
GLOBAL_DB_TOKEN=<token-db-jwt-prod>

# --- Turso provisioning (fan-out migrasi + create Project DB, F.2/F.3) ---
# WAJIB terpisah dari staging — jangan pernah menyamakan dengan staging, tidak ada
# fallback default di kode (migrate-projects.ts) supaya salah environment gagal cepat.
TURSO_API_TOKEN=<token-api-org>
TURSO_ORG=ngodingin-ai
TURSO_GROUP=ngodingin-kanban

# --- Better Auth (0.8.x) ---
# Secret minimal 32 karakter; WAJIB beda dari dev/staging
BETTER_AUTH_SECRET=<minimal-32-karakter-acak-prod>
# Canonical origin production (D.7)
BETTER_AUTH_URL=https://kanban.ngodingin.xyz

# --- Resend (Magic Link, 0.8.4) ---
# Secret production WAJIB terpisah dari staging walau sender sama (D.7)
AUTH_RESEND_KEY=re_<secret-resend-prod>
MAIL_FROM=noreply@kanban.ngodingin.xyz
