# NGodingin Kanban — Environment: staging
# Nilai diisi sebagai Environment Variables Vercel untuk project staging
# (tidak dicommit; template ini hanya dokumentasi kunci D.7).

# --- Global DB (control plane) — DB staging terisolasi penuh dari prod/dev (D.7) ---
GLOBAL_DB_URL=https://<org>-<db-staging>-<instance>.turso.io
GLOBAL_DB_TOKEN=<token-db-jwt-staging>

# --- Better Auth (0.8.x) ---
# Secret minimal 32 karakter; WAJIB beda dari dev/prod
BETTER_AUTH_SECRET=<minimal-32-karakter-acak-staging>
# Canonical origin staging (D.7, SOT 2.0.7).
BETTER_AUTH_URL=https://kanban-ngodingin.vercel.app

# --- Resend (Magic Link, 0.8.4) ---
# Secret staging WAJIB terpisah dari production walau sender sama (D.7)
AUTH_RESEND_KEY=re_<secret-resend-staging>
MAIL_FROM=noreply@kanban.ngodingin.xyz
