# NGodingin Kanban — Environment: development
# Salin ke .env lalu isi nilai asli. JANGAN commit .env (sudah di .gitignore).
# D.7: dev memakai localhost eksplisit; transport/sender test, tidak boleh mengirim
# sebagai production tanpa konfigurasi sadar.

# --- Turso (POC 0.2.x) ---
TURSO_DB_URL=
TURSO_DB_TOKEN=
TURSO_API_TOKEN=
TURSO_ORG=
TURSO_GROUP=

# --- Global DB (control plane) — DB development terisolasi penuh (D.7) ---
GLOBAL_DB_URL=https://<org>-<db-dev>-<instance>.turso.io
GLOBAL_DB_TOKEN=<token-db-jwt-dev>

# --- Better Auth (0.8.x) ---
# Secret minimal 32 karakter; WAJIB beda dari staging/prod
BETTER_AUTH_SECRET=<minimal-32-karakter-acak-dev>
# Canonical origin dev: localhost eksplisit (D.7)
BETTER_AUTH_URL=http://localhost:5173

# --- Resend (Magic Link, 0.8.4) ---
# Dev: boleh pakai test key / tidak diisi (sender test injectable)
AUTH_RESEND_KEY=
MAIL_FROM=noreply@kanban.ngodingin.xyz
