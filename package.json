{
  "name": "ngodingin-kanban",
  "version": "0.0.0",
  "private": true,
  "description": "NGodingin Kanban — project management / Kanban platform (API-based, multi-tenant via database-per-project)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
