    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@vercel/speed-insights": "2.0.0",
    "drizzle-orm": "0.45.2",
    "ulid": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}