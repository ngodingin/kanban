# Ignore node modules and build artifacts to keep image lean
node_modules
npm-debug.log
yarn-debug.log
pnpm-debug.log

# Ignore local env and secrets
.env
.env.local
.env.*

# Git metadata and CI
.git
.gitignore
.github

# Editor dirs
.vscode
.idea

# Next.js build output
.next
out
dist
build

# Logs and coverage
*.log
logs
coverage

# Project docs and local-only files
AGENTS.md
CLAUDE.md
PHASE-*.md

# Dockerfile and dockerignore themselves are not copied
Dockerfile
.dockerignore
